:root{--bg:#08090b;--panel:#111318;--panel2:#161920;--line:#252a33;--text:#f3f5f7;--muted:#8e96a3;--accent:#c7ff3d;--accent2:#aee52f;--shadow:0 20px 60px rgba(0,0,0,.28)}
*{box-sizing:border-box}body{background:radial-gradient(circle at 85% -10%,rgba(199,255,61,.08),transparent 28%),var(--bg);color:var(--text)}button,input,textarea{font:inherit}.app-shell{max-width:820px;margin:auto}.topbar{background:rgba(8,9,11,.82);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.05);position:sticky;top:0;z-index:20}.brand-mark{background:var(--accent);color:#070807;border-radius:12px;font-weight:950}.brand h1{letter-spacing:-.04em}.page-head,.today-intro{padding:28px 4px 18px}.page-head h2,.today-intro h2{font-size:clamp(32px,8vw,54px);line-height:.95;letter-spacing:-.06em;margin:7px 0 10px}.page-head p,.today-intro p{color:var(--muted);max-width:600px}.eyebrow{font-size:10px;letter-spacing:.18em;font-weight:900;color:var(--accent)}
.progress-track{height:5px;background:#1a1e24;border-radius:999px;margin:0 4px 20px;overflow:hidden}.progress-track i{display:block;height:100%;background:var(--accent);border-radius:inherit}.session-score{background:var(--accent);color:#080908;border-radius:20px;min-width:74px;height:74px;padding:12px;display:grid;place-content:center;text-align:center}.session-score strong{font-size:27px;line-height:.8}.session-score span{font-size:11px;font-weight:800}.session-score small{font-size:8px;font-weight:950;letter-spacing:.15em;margin-top:5px}.today-intro{display:flex;justify-content:space-between;gap:16px}.up-next,.smart-target{background:linear-gradient(110deg,rgba(199,255,61,.12),rgba(199,255,61,.03));border:1px solid rgba(199,255,61,.18);border-radius:18px;padding:14px 16px;margin:0 0 14px}.up-next span,.smart-target span{display:block;color:var(--accent);font-size:9px;letter-spacing:.15em;font-weight:950}.up-next strong{display:block;margin:5px 0 2px}.up-next small,.smart-target strong{color:var(--muted);font-size:12px;font-weight:600}.neo-exercise{background:linear-gradient(145deg,#12151a,#0e1014);border:1px solid var(--line);border-radius:25px;overflow:hidden;margin:14px 0;box-shadow:var(--shadow);transition:.2s}.neo-exercise.is-next{border-color:rgba(199,255,61,.4);box-shadow:0 18px 60px rgba(199,255,61,.07)}.exercise-cover{display:block;width:100%;padding:0;border:0;background:#0b0d10;text-align:left;position:relative}.exercise-tag{position:absolute;left:16px;bottom:14px;background:rgba(0,0,0,.62);padding:6px 9px;border-radius:9px;color:#dfe4e9;font-size:9px;font-weight:850;letter-spacing:.08em}.open-detail{position:absolute;right:14px;top:14px;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.55);display:grid;place-items:center}.exercise-art{height:130px;position:relative;overflow:hidden;background:linear-gradient(135deg,#15191e,#090a0d)}.exercise-art:before{content:"";position:absolute;inset:-30%;background:radial-gradient(circle at 55% 35%,rgba(199,255,61,.14),transparent 28%),linear-gradient(120deg,transparent 35%,rgba(255,255,255,.025) 36%,transparent 37%);transform:rotate(-8deg)}.exercise-art span{position:absolute;right:15px;bottom:14px;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:#aeb5be;font-weight:900}.art-person{position:absolute;left:50%;top:50%;width:90px;height:75px;transform:translate(-50%,-42%)}.art-person i{position:absolute;width:22px;height:22px;border-radius:50%;background:#7e8894;left:36px;top:3px}.art-person b{position:absolute;width:12px;height:52px;background:#aeb5bd;border-radius:8px;left:41px;top:22px;transform:rotate(17deg)}.art-person em{position:absolute;width:72px;height:7px;background:var(--accent);border-radius:99px;left:9px;top:36px;box-shadow:0 0 20px rgba(199,255,61,.25)}.art-floor{position:absolute;left:10%;right:10%;bottom:18px;height:1px;background:#313741}.neo-body{padding:18px}.neo-title{display:flex;justify-content:space-between;gap:10px}.exercise-num{color:#6e7681;font-size:10px;font-weight:900;letter-spacing:.14em}.neo-title h3{font-size:21px;letter-spacing:-.035em;margin:3px 0}.neo-title p{font-size:11px;color:var(--muted);margin:0}.next-pill{background:var(--accent);color:#070807;border-radius:99px;padding:6px 8px;font-size:9px;align-self:flex-start}.last-line{display:flex;gap:9px;align-items:center;border-bottom:1px solid var(--line);padding:11px 0 13px;margin-bottom:13px}.last-line span{font-size:8px;letter-spacing:.14em;color:#6f7782;font-weight:900}.last-line b{font-size:12px}.neo-set{display:grid;grid-template-columns:28px 1fr 12px 1fr 46px;gap:8px;align-items:center;margin:7px 0}.neo-set>span{font-size:10px;color:#707986;font-weight:900}.neo-set .input{min-width:0;height:48px;background:#090b0e;border:1px solid #292e37;border-radius:13px;text-align:center;font-size:17px;font-weight:850;color:var(--text)}.neo-set .input:focus{border-color:var(--accent);outline:none}.neo-set b{color:#666e78;text-align:center}.done{height:48px;border:1px solid #303640;background:#171a20;color:#737b87;border-radius:13px;font-size:20px;font-weight:900}.done.done{background:var(--accent);color:#080908;border-color:var(--accent)}.exercise-note{width:100%;resize:none;min-height:40px;background:transparent;border:0;border-top:1px solid var(--line);margin-top:10px;padding:12px 0 0;color:#c9ced5;font-size:11px;outline:none}.exercise-note::placeholder{color:#555d68}.smart-target strong{display:block;margin-top:4px}.neo-finish{margin-top:18px}.microcopy{text-align:center;color:#5d6570;font-size:10px;padding:12px 25px 30px}.timer{margin-bottom:14px!important}.completion-neo{text-align:center;padding:55px 8px 30px}.completion-glow{width:90px;height:90px;border-radius:30px;background:var(--accent);color:#080908;display:grid;place-items:center;font-size:44px;font-weight:950;margin:0 auto 28px;box-shadow:0 0 60px rgba(199,255,61,.2)}.completion-neo h2{font-size:46px;letter-spacing:-.07em;margin:8px 0}.completion-neo p{color:var(--muted)}.completion-grid,.stat-deck,.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:25px 0}.completion-grid div,.small-stat,.big-stat,.detail-grid>div{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:16px}.completion-grid strong,.small-stat strong,.big-stat strong,.detail-grid strong{display:block;font-size:24px;letter-spacing:-.04em}.completion-grid span,.small-stat span,.big-stat span,.detail-grid small{font-size:8px;letter-spacing:.14em;text-transform:uppercase;color:#777f89;font-weight:900}.pr-banner{display:flex;align-items:center;gap:12px;text-align:left;background:linear-gradient(110deg,rgba(199,255,61,.13),rgba(199,255,61,.03));border:1px solid rgba(199,255,61,.22);padding:14px;border-radius:17px;margin:15px 0 20px}.pr-banner span{font-size:24px}.pr-banner b,.pr-banner small{display:block}.pr-banner small{color:var(--muted);margin-top:3px}.day-rail{display:flex;gap:8px;overflow:auto;padding:4px 0 16px;scrollbar-width:none}.day-rail::-webkit-scrollbar{display:none}.day-chip{min-width:72px;background:#111419;border:1px solid var(--line);color:#8c949f;border-radius:16px;padding:10px 8px}.day-chip.active{background:var(--accent);color:#080908;border-color:var(--accent)}.day-chip b,.day-chip span{display:block}.day-chip b{font-size:17px}.day-chip span{font-size:8px;font-weight:900;letter-spacing:.1em;margin-top:3px}.program-hero{display:flex;align-items:center;justify-content:space-between;gap:15px;background:linear-gradient(135deg,#161a20,#0d0f13);border:1px solid var(--line);border-radius:25px;padding:22px;margin:5px 0 12px}.program-hero h3{font-size:25px;margin:5px 0}.program-hero p{font-size:11px;color:var(--muted);margin:0}.program-tile{width:100%;display:grid;grid-template-columns:34px 82px 1fr 20px;align-items:center;gap:12px;background:#101318;border:1px solid var(--line);color:var(--text);border-radius:20px;padding:9px;margin:8px 0;text-align:left}.program-tile .exercise-art{height:64px;border-radius:13px}.program-tile .exercise-art span,.program-tile .open-detail{display:none}.program-tile strong,.program-tile small,.program-tile em{display:block}.program-tile small,.program-tile em{font-size:9px;color:#747d88;margin-top:3px;font-style:normal}.tile-number{font-size:10px;color:#626a76;font-weight:900}.program-tile>b{font-size:24px;color:#626a76}.neo-volume,.neo-focus{margin-bottom:24px}.stat-deck{grid-template-columns:2fr 1fr 1fr}.big-stat{grid-row:span 2;background:linear-gradient(145deg,rgba(199,255,61,.12),#111318);display:flex;flex-direction:column;justify-content:center}.big-stat strong{font-size:46px;color:var(--text);margin:5px 0}.big-stat i{font-size:14px;font-style:normal;color:#7e8792}.big-stat small,.small-stat small{color:#737c87;font-size:9px}.neo-chart{height:220px}.neo-focus>div{margin:14px 0}.neo-focus>div>div{display:flex;justify-content:space-between;font-size:11px}.neo-focus b{color:#8c95a0}.neo-focus i{display:block;height:5px;background:#20242b;border-radius:99px;margin-top:7px}.neo-focus u{display:block;height:100%;background:var(--accent);border-radius:inherit;text-decoration:none}.history-card{border:1px solid var(--line)!important}.neo-history em{font-style:normal;color:var(--accent);font-size:9px}.modal-ex{padding:13px 0;border-bottom:1px solid var(--line)}.modal-ex strong,.modal-ex span,.modal-ex small{display:block}.modal-ex span{font-size:11px;color:#aeb5be;margin-top:4px}.modal-ex small{font-size:10px;color:#69727d;margin-top:4px}.detail-hero{margin-bottom:15px}.detail-hero .exercise-art{border-radius:18px}.detail-title{margin-top:16px}.detail-title h2{margin:4px 0;font-size:30px;letter-spacing:-.05em}.detail-title p,.modal-sub{color:var(--muted);font-size:11px}.detail-grid{grid-template-columns:repeat(3,1fr)}.detail-grid strong{font-size:22px;margin-top:4px}.detail-grid i{font-style:normal;font-size:9px;color:#747c87}.smart-box{border:1px solid rgba(199,255,61,.2);background:rgba(199,255,61,.07);border-radius:17px;padding:14px;margin:15px 0}.smart-box span{font-size:8px;letter-spacing:.14em;color:var(--accent);font-weight:900}.smart-box strong,.smart-box p{display:block}.smart-box strong{margin-top:5px}.smart-box p{font-size:11px;color:#8d96a1;margin:4px 0 0}.detail-row{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-bottom:1px solid var(--line);font-size:10px}.detail-row span{color:#747d87}.detail-row b{text-align:right}.neo-settings .setting-row{min-height:70px}.version{text-align:center;color:#555d68;font-size:9px;letter-spacing:.15em;padding:28px}.hidden{display:none!important}@media(max-width:560px){main{padding:0 14px 105px}.topbar{padding:12px 14px}.completion-grid,.detail-grid{gap:6px}.completion-grid div,.detail-grid>div{padding:12px}.stat-deck{grid-template-columns:1fr 1fr}.big-stat{grid-column:1/-1;grid-row:auto}.small-stat{min-height:82px}.program-tile{grid-template-columns:26px 65px 1fr 15px;gap:8px}.program-tile .exercise-art{height:60px}.modalbox{width:calc(100% - 22px)!important}.neo-set{grid-template-columns:24px 1fr 10px 1fr 45px}}
